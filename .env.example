# Supabase 配置
# 从 Supabase Dashboard -> Settings -> API 获取
# 注意: NEXT_PUBLIC_ 前缀的变量会暴露到客户端,这是安全的设计
# Anon Key 是公开的密钥,安全性由 Supabase RLS (Row Level Security) 保障
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ 警告: 以下密钥绝对不能公开,不要添加 NEXT_PUBLIC_ 前缀
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (仅在服务器端使用)

# Supabase Auth 回调 URL (本地开发)
# 生产环境会自动使用正确的域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter API Key (用于图片生成功能)
# 这个 key 只在服务器端使用,不会暴露到客户端
OPENROUTER_API_KEY=your-openrouter-api-key

# Creem 支付配置
# 从 Creem Dashboard 获取 API Key: https://creem.io/dashboard/api-keys
# ⚠️ 警告: 此密钥只在服务器端使用,不要添加 NEXT_PUBLIC_ 前缀
CREEM_API_KEY=your_creem_api_key_here

# Creem Webhook Secret (用于验证 Webhook 签名)
# 从 Creem Dashboard -> Webhooks 页面创建 Webhook 后获取
# ⚠️ 警告: 此密钥非常重要,用于验证 Webhook 请求的真实性
CREEM_WEBHOOK_SECRET=your_webhook_secret_here

# Creem 产品 ID (在 Creem Dashboard 创建产品后获取)
# 你需要为每个套餐和计费周期创建对应的产品
# Basic 套餐
CREEM_PRODUCT_BASIC_MONTHLY=prod_basic_monthly_id
CREEM_PRODUCT_BASIC_YEARLY=prod_basic_yearly_id

# Pro 套餐
CREEM_PRODUCT_PRO_MONTHLY=prod_pro_monthly_id
CREEM_PRODUCT_PRO_YEARLY=prod_pro_yearly_id

# Max 套餐
CREEM_PRODUCT_MAX_MONTHLY=prod_max_monthly_id
CREEM_PRODUCT_MAX_YEARLY=prod_max_yearly_id

# 应用基础 URL (用于支付回调)
# 本地开发使用 http://localhost:3000
# 生产环境使用实际域名,如 https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Mock 模式 (仅用于开发测试)
# 设置为 true 时，跳过 Creem API 调用，直接模拟支付成功
# ⚠️ 警告：生产环境必须设置为 false
ENABLE_PAYMENT_MOCK=false

